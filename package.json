{
  "name": "study-time-tracker",
  "version": "1.0.0",
  "description": "A simple dark-mode Windows study time tracker",
  "author": "Ashish Bharadwaj",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/unit.test.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.coadcraft.studytracker",
    "productName": "Study Time Tracker",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "mini-preload.js",
      "focus-engine.js",
      "index.html",
      "mini-timer.html",
      "styles.css",
      "renderer.js",
      "mini-renderer.js",
      "package.json"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Study Time Tracker",
      "uninstallDisplayName": "Study Time Tracker"
    }
  }
}